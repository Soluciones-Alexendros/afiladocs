# ==============================================================================
# AFILADOCS — ENVIRONMENT VARIABLES
# ==============================================================================
# Copia este archivo como .env.local para desarrollo. Las claves aquí son
# espejo del schema validado en src/lib/env.ts.
# NO COMITEAR archivos .env reales.
# ==============================================================================

# ─── CORE ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=dev

# ─── SUPABASE (Vercel Marketplace Free — no self-hosted) ──────────────────────
# En Vercel estas vars las inyecta el recurso Marketplace al linkarlo al
# proyecto afiladocs. No inventar JWT. supabase.afiladocs.com está descatalogado.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── DATABASE (Prisma; mismas credenciales que inyecta Marketplace) ───────────
# DATABASE_URL: pooler (runtime / serverless)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: directo (sólo prisma migrate)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── STRIPE ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── RESEND (email transaccional) ────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=no-reply@afiladocs.com

# ─── DOCUSEAL (firma electrónica, activo) ────────────────────────────────────
DOCUSEAL_API_URL=https://docuseal.[DOMAIN].com
DOCUSEAL_API_KEY=docuseal_...
DOCUSEAL_WEBHOOK_SECRET=docuseal_whsec_...

# ─── STORAGE & SLA ────────────────────────────────────────────────────────────
TEMPLATES_BUCKET=templates
REVIEW_SLA_HOURS=72

# ─── N8N (automations) ────────────────────────────────────────────────────────
N8N_CONTACT_WEBHOOK_URL=https://n8n.[DOMAIN].com/webhook/contacto/...
N8N_ALERTS_WEBHOOK_SECRET=n8n_alerts_sec_...
N8N_ERROR_WEBHOOK_URL=https://n8n.[DOMAIN].com/webhook/errors/...

# ─── UPSTASH REDIS (rate limiting, opcional) ──────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# ─── CRON JOBS ────────────────────────────────────────────────────────────────
CRON_SECRET=cron_sec_...

# ─── OPS ──────────────────────────────────────────────────────────────────────
OPS_EMAIL=ops@afiladocs.com
# Lista ISO-3166 alpha-2 separada por comas (ej: "CN,RU"). Vacío = sin geo-block.
GEO_BLOCKED_COUNTRIES=

# ─── EASYVERIFACTU (facturación electrónica, opcional) ───────────────────────
EASYVERIFACTU_API_URL=https://api.easyverifactu.com/v1
EASYVERIFACTU_API_KEY=ev_...

# ─── SENTRY (integración Vercel inyecta OBSERVABILITY_SENTRY_*) ──────────────
# Placeholders — sin valores reales. En Vercel los inyecta la integración.
NEXT_PUBLIC_OBSERVABILITY_SENTRY_DSN=
OBSERVABILITY_SENTRY_AUTH_TOKEN=
OBSERVABILITY_SENTRY_ORG=
OBSERVABILITY_SENTRY_PROJECT=
# Alias legacy (next.config / Sentry CLI); preferir OBSERVABILITY_SENTRY_AUTH_TOKEN.
SENTRY_AUTH_TOKEN=

# ─── TOOLING LOCAL / CI (opcionales) ─────────────────────────────────────────
# ANALYZE=true  → bundle analyzer en `pnpm analyze`
# SMOKE_BASE_URL / SMOKE_PORT / SMOKE_TIMEOUT_MS → scripts/smoke.ts
# PLAYWRIGHT_BASE_URL → e2e
